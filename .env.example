# Copy to .env (never commit .env) and fill in real values.
# The Groq key is server-side only. It is never sent to the mobile client,
# the admin frontend, or API responses.

# Provider selection. groq = hosted Groq (requires GROQ_API_KEY).
# rule_based = deterministic local extractor (no network).
ECHO_LLM_PROVIDER=groq
GROQ_API_KEY=replace-with-your-groq-key
GROQ_MODEL=openai/gpt-oss-120b
GROQ_BASE_URL=https://api.groq.com/openai/v1

# Free-plan limits (see docs/AI_PIPELINE.md for date and sources).
ECHO_GROQ_RPM=30
ECHO_GROQ_RPD=1000
ECHO_GROQ_TPM=8000
ECHO_GROQ_TPD=200000

# Local speech-to-text (audio never leaves the server).
# tiny = fastest/default; base.en or small.en = more accurate English.
ECHO_WHISPER_MODEL=tiny
ECHO_WHISPER_COMPUTE_TYPE=int8

# Bounded retries and provider timeout.
ECHO_LLM_TIMEOUT_SECONDS=45
ECHO_LLM_MAX_RETRIES=3
ECHO_LLM_REPAIR_ATTEMPTS=1

# Admin console token (required for /api/admin/*). Empty fails closed.
ECHO_ADMIN_TOKEN=replace-with-a-long-random-token

# Local development environment for the Echo server (dev-only values).
# Copy to .env (or export) before running the server.

# Primary database. Postgres 16 via docker compose; the server, seed script,
# Alembic migrations and the worker all read this single URL.
DATABASE_URL=postgresql://echo:echo_dev_password@127.0.0.1:5432/echo_kb

# Uploads / verification-email outbox stay on the filesystem.
ECHO_UPLOAD_DIR=server/uploads
ECHO_EMAIL_OUTBOX=server/outbox

# Background worker. "0" keeps the API process worker-free (compose runs the
# worker as its own service; the source default below applies to bare runs).
ECHO_WORKER_ENABLED=0

# Job retry policy (owner decision D7): 3 attempts total, 30s/120s backoff,
# +/-20% jitter. All env-overridable.
ECHO_JOB_MAX_ATTEMPTS=3
ECHO_JOB_BACKOFF_A1_SECONDS=30
ECHO_JOB_BACKOFF_A2_SECONDS=120
ECHO_JOB_BACKOFF_JITTER=0.2

# Connection pool (both API and worker).
ECHO_DB_POOL_MIN=1
ECHO_DB_POOL_MAX=4
ECHO_DB_CONNECT_TIMEOUT=30
ECHO_DB_STATEMENT_TIMEOUT_MS=30000
ECHO_DB_IDLE_IN_TX_TIMEOUT_MS=30000

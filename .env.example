# Gusby Environment Configuration Template
# Copy this file to .env and configure your local settings.
# NEVER commit .env or paste API keys into git.

# PostgreSQL Connection String (Postgres 16)
DATABASE_URL=postgresql://echo:echo_dev_password@127.0.0.1:5432/echo_kb
# GUSBY_DATABASE_URL=

# Gusby API Backend Server Port (Default: 8080)
PORT=8080
GUSBY_ENV=development

# Groq LLM API Configuration (OpenAI-compatible)
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=openai/gpt-oss-120b
GROQ_BASE_URL=https://api.groq.com/openai/v1

# Groq Free-Tier Rate Limits (Requests per Minute / Tokens per Minute)
GROQ_RPM=30
GROQ_TPM=8000

# User Budgeting & Quota (Daily Tokens per User)
GUSBY_DAILY_USER_TOKEN_BUDGET=40000

# Session Secret Key (Change in production)
GUSBY_SESSION_SECRET=gusby-default-insecure-secret-key-change-in-prod

# Frontend Desktop Nuxt 3 Client Base URL (Used by Nuxt)
GUSBY_API_BASE=http://127.0.0.1:8080

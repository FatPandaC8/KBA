# ==============================================================================
# Gusby Environment Configuration Template
# ==============================================================================
# Copy this file to .env and configure your environment variables.
# NEVER commit your actual .env file or real API keys to version control.

# ------------------------------------------------------------------------------
# 1. Environment & Network Binding
# ------------------------------------------------------------------------------
# Runtime environment: "development" or "production"
# In production, strict validation is enforced (non-default secrets, valid DB URL, etc.)
GUSBY_ENV=development

# Network bind address for the Go Backend HTTP server (Default: 127.0.0.1)
# Keep on loopback (127.0.0.1) so the backend is never exposed directly to the internet.
GUSBY_HOST=127.0.0.1

# Network port for the Go Backend HTTP server (Default: 8081)
# (Port 8080 is reserved for Nginx reverse proxy)
GUSBY_PORT=8081

# ------------------------------------------------------------------------------
# 2. Database Configuration (PostgreSQL 16 - 18+)
# ------------------------------------------------------------------------------
# Canonical database connection string.
# In production, use dedicated database (e.g. gusby_db) and non-superuser role (e.g. gusby_user).
# Never point production to the default dev database or expose port 5432 publicly.
# Development default:
DATABASE_URL=postgresql://echo:echo_dev_password@127.0.0.1:5432/echo_kb
# Production example:
# GUSBY_DATABASE_URL=postgresql://gusby_user:STRONG_UNIQUE_PASSWORD@127.0.0.1:5432/gusby_db

# ------------------------------------------------------------------------------
# 3. Security, Authentication & CORS
# ------------------------------------------------------------------------------
# Secret key used for session cookie signing & CSRF validation.
# In production (GUSBY_ENV=production), this MUST be at least 32 characters long
# and cannot be the default insecure placeholder.
# Generate via: openssl rand -base64 32
GUSBY_SESSION_SECRET=gusby-default-insecure-secret-key-change-in-prod

# Comma-separated list of allowed CORS and CSRF origins.
# Defaults include loopback dev ports and deployment origins (8080, 8081, 3000).
# In production with a custom domain or Cloudflare Tunnel, add your domain here:
# GUSBY_CORS_ALLOWED_ORIGINS=https://gusby.yourdomain.com,http://127.0.0.1:8080

# System Owner Admin Email (auto-granted is_admin on first startup)
GUSBY_OWNER_EMAIL=admin@example.com

# ------------------------------------------------------------------------------
# 4. Groq LLM API Configuration (OpenAI-compatible)
# ------------------------------------------------------------------------------
# Required for real AI extraction, entity resolution, and conflict classification.
# Obtain from https://console.groq.com/keys
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=openai/gpt-oss-120b
GROQ_BASE_URL=https://api.groq.com/openai/v1

# Groq Free-Tier Rate Limits (Requests per Minute / Tokens per Minute)
GROQ_RPM=30
GROQ_TPM=8000

# Daily token usage budget per user (prevents quota exhaustion)
GUSBY_DAILY_USER_TOKEN_BUDGET=40000

# ------------------------------------------------------------------------------
# 5. Frontend & Development Seed Accounts
# ------------------------------------------------------------------------------
# Frontend API Base URL:
# - In production behind Nginx reverse proxy: leave empty ("") for same-origin relative requests (/api/...)
# - In development with standalone Nuxt dev server on :3000: set to http://127.0.0.1:8081 or leave empty
GUSBY_API_BASE=

# Target backend URL for Nuxt local dev proxy (when running `npm run dev`)
GUSBY_BACKEND_URL=http://127.0.0.1:8081

# Development seed accounts auto-sync (Set to false in production)
E2E_SEED_ENABLED=false
# E2E_ADMIN_EMAIL=admin@example.com
# E2E_ADMIN_PASSWORD=AdminPassword123!

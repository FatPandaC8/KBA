# ==============================================================================
# Gusby Environment Configuration Template
# ==============================================================================
# Copy this file to your production runtime location:
#   cp .env.example ~/services/gusby/.env
#   chmod 600 ~/services/gusby/.env
#
# NEVER commit your actual .env file or real secrets to version control.
# Real secrets must be generated directly on the target host.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Environment & Network Binding
# ------------------------------------------------------------------------------
# Runtime environment: "development" or "production"
# In "production", strict validation enforces dedicated DB and minimum 32-char session secret.
GUSBY_ENV=production

# Network bind address for the Go Backend HTTP server (Default: 127.0.0.1)
# Keep strictly on loopback (127.0.0.1) so backend is not exposed directly.
GUSBY_HOST=127.0.0.1

# Network port for the Go Backend HTTP server (Default: 8081)
# (Port 8080 is reserved for Nginx reverse proxy)
GUSBY_PORT=8081

# ------------------------------------------------------------------------------
# 2. Dedicated Database Configuration (PostgreSQL 16 - 18+)
# ------------------------------------------------------------------------------
# Canonical database connection string.
# PRECEDENCE RULE: GUSBY_DATABASE_URL takes precedence over DATABASE_URL.
#
# CRITICAL SAFETY REQUIREMENT:
# - Gusby MUST use a dedicated database (e.g. gusby_db) and non-superuser role (e.g. gusby_user).
# - NEVER point Gusby to 'server_lab'. The application and migration scripts will reject 'server_lab'.
#
# Example production connection string:
GUSBY_DATABASE_URL=postgresql://gusby_user:GENERATE_A_STRONG_PASSWORD@127.0.0.1:5432/gusby_db?sslmode=disable

# Optional validation variable for scripts (fails fast if connected to wrong database):
GUSBY_EXPECTED_DB=gusby_db

# ------------------------------------------------------------------------------
# 3. Security, Authentication & CORS
# ------------------------------------------------------------------------------
# Secret key used for session cookie signing & CSRF validation.
# In production (GUSBY_ENV=production), this MUST be at least 32 characters long.
# Generate on target host with: openssl rand -base64 32
GUSBY_SESSION_SECRET=GENERATE_WITH_OPENSSL_RAND_BASE64_32

# Comma-separated list of allowed CORS and CSRF origins.
# In production with Cloudflare Tunnel or a custom domain, configure here:
# GUSBY_CORS_ALLOWED_ORIGINS=https://gusby.example.com,http://127.0.0.1:8080
GUSBY_CORS_ALLOWED_ORIGINS=http://127.0.0.1:8080,http://localhost:8080

# System Owner Admin Email (bootstrapped with is_admin = true on first startup)
GUSBY_OWNER_EMAIL=admin@example.com

# ------------------------------------------------------------------------------
# 4. Groq LLM API Configuration
# ------------------------------------------------------------------------------
# Required in production for knowledge extraction and entity resolution.
# Obtain key from https://console.groq.com/keys
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=openai/gpt-oss-120b
GROQ_BASE_URL=https://api.groq.com/openai/v1

# Groq Rate Limits (Requests per Minute / Tokens per Minute)
GROQ_RPM=30
GROQ_TPM=8000

# Daily token usage budget per user (prevents quota exhaustion)
GUSBY_DAILY_USER_TOKEN_BUDGET=40000

# ------------------------------------------------------------------------------
# 5. Frontend Client Configuration
# ------------------------------------------------------------------------------
# Frontend API Base URL:
# - In production behind Nginx reverse proxy: leave empty ("") for same-origin relative requests (/api/...)
GUSBY_API_BASE=

# Target backend URL for local development proxy (when running `npm run dev`)
GUSBY_BACKEND_URL=http://127.0.0.1:8081

# ------------------------------------------------------------------------------
# 6. Development & E2E Testing Seed Accounts (Optional)
# ------------------------------------------------------------------------------
# When enabled (E2E_SEED_ENABLED=true or 1), the backend automatically provisions
# or synchronizes development user accounts into gusby.users on startup (see internal/auth/seed.go).
#
# CRITICAL SAFETY NOTE:
# - In PRODUCTION, MUST be kept false (E2E_SEED_ENABLED=false).
# - In DEVELOPMENT or local E2E testing, set E2E_SEED_ENABLED=true and configure:
E2E_SEED_ENABLED=false
E2E_ADMIN_EMAIL=device-admin@example.test
E2E_ADMIN_PASSWORD=DevicePass1234
E2E_USER_1_EMAIL=device-user1@example.test
E2E_USER_1_PASSWORD=DevicePass1234
E2E_USER_2_EMAIL=device-user2@example.test
E2E_USER_2_PASSWORD=DevicePass1234
E2E_USER_3_EMAIL=device-user3@example.test
E2E_USER_3_PASSWORD=DevicePass1234


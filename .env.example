# Local development only. Copy to .env; never commit .env or real credentials.
# These values match docker-compose.yml and are not production credentials.
DATABASE_URL=postgresql://echo:echo_dev_password@127.0.0.1:5432/echo_kb

# Generate a private value, e.g.:
# python -c 'import secrets; print(secrets.token_urlsafe(32))'
ECHO_ADMIN_TOKEN=replace-this-with-a-private-random-value

# Providers are selected at server startup, never supplied per request.
ECHO_STT_PROVIDER=faster_whisper
ECHO_KB_EXTRACTOR=local
ECHO_LLM_PROVIDER=rule_based
# Set ECHO_KB_EXTRACTOR=groq and ECHO_LLM_PROVIDER=groq to use Groq.
# GROQ_API_KEY=
# GROQ_MODEL=openai/gpt-oss-120b
# Current Groq client transport behavior (bounded retries inside the request).
ECHO_LLM_MAX_RETRIES=3
ECHO_LLM_MAX_RETRY_WAIT_SECONDS=8
ECHO_LLM_REPAIR_ATTEMPTS=1
ECHO_LLM_TIMEOUT_SECONDS=45

# Request and audio limits.
ECHO_MAX_VOICE_SECONDS=120
ECHO_MAX_UPLOAD_BYTES=26214400
ECHO_MAX_TEXT_KB_CHARS=20000
ECHO_WHISPER_MODEL=tiny
ECHO_WHISPER_COMPUTE_TYPE=int8

# Local filesystem paths used by the server for uploads/legacy retained audio
# and the development email outbox. New app captures do not upload audio.
ECHO_UPLOAD_DIR=server/uploads
ECHO_EMAIL_OUTBOX=server/outbox

# Optional database pool settings.
ECHO_DB_POOL_MIN=1
ECHO_DB_POOL_MAX=4
ECHO_DB_CONNECT_TIMEOUT=30
ECHO_DB_STATEMENT_TIMEOUT_MS=30000
ECHO_DB_IDLE_IN_TX_TIMEOUT_MS=30000
ECHO_DB_SYNCHRONOUS_COMMIT=on

# Optional browser-only CORS origins; Android does not use CORS.
# ECHO_CORS_ORIGINS=http://127.0.0.1:5174

# Optional deterministic admin seed credentials (development/test only).
# E2E_SEED_ENABLED=true
# E2E_ADMIN_EMAIL=admin@example.test
# E2E_ADMIN_PASSWORD=change-this
# E2E_USER_1_EMAIL=user1@example.test
# E2E_USER_1_PASSWORD=change-this
# E2E_USER_2_EMAIL=user2@example.test
# E2E_USER_2_PASSWORD=change-this
# E2E_USER_3_EMAIL=user3@example.test
# E2E_USER_3_PASSWORD=change-this
